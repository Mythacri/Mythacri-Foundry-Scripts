<div class="components">
  {{#each components}}
  <div class="column">
    <div class="component-header">
      <img src="{{icon}}" data-identifier="{{identifier}}">
      <span class="label">{{label}}</span>
      <span class="counter">({{ifThen assigned assigned.system.quantity 0}}/{{quantity}})</span>
    </div>
    <div class="resources">
      {{#each resources}}
      <a class="component {{#if active}} active {{/if}}" data-tooltip-html="{{tooltipHint}}" data-identifier="{{../identifier}}" data-item-id="{{resource.id}}" data-tooltip-class="{{tooltipCss}}" data-action="selectComponent">
        <img src="{{resource.img}}" alt="{{resource.name}}">
        <span class="quantity">&times; {{resource.system.quantity}}</span>
      </a>
      {{/each}}
    </div>
  </div>
  {{/each}}
</div>
